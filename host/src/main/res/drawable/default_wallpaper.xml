<!-- host/src/main/res/drawable/default_wallpaper.xml -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="1080dp"
    android:height="1920dp"
    android:viewportWidth="1080"
    android:viewportHeight="1920">
    <!-- Windows 10 默认蓝色渐变背景 -->
    <path
        android:fillColor="#0078D7"
        android:pathData="M0,0 L1080,0 L1080,1920 L0,1920 Z" />
    <path
        android:fillColor="#005A9E"
        android:pathData="M0,0 L1080,0 L1080,960 L0,960 Z" />
    <!-- 装饰性光效 -->
    <path
        android:fillColor="#0099FF"
        android:pathData="M540,960 L1080,1920 L0,1920 Z"
        android:fillAlpha="0.15" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M540,0 L1080,960 L0,960 Z"
        android:fillAlpha="0.05" />
</vector>