<?xml version="1.0" encoding="utf-8"?>
<plugin xmlns:android="http://schemas.android.com/apk/res/android"
    id="com.example.plugin.sample"
    name="Sample Plugin"
    version="1.0.0"
    entrypoint="com.example.plugin.sample.SamplePluginService"
    minHostVersion="1.0"
    >
    <!-- Requested permissions that host should grant -->
    <permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>
    
    <!-- Extension points this plugin implements -->
    <extension point="panel"/>
    <extension point="shortcut"/>
    <extension point="search"/>
    <extension point="settings"/>
</plugin>